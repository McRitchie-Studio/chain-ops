<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Chain Ops" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <% unless Rails.env.production? %>
      <div class="environment-banner">
        <span><%= Rails.env.capitalize %> Environment</span>
        <span>Chain Ops Local</span>
      </div>
    <% end %>

    <header class="topbar">
      <div>
        <p class="eyebrow">McRitchie Chain Ops</p>
        <h1>Localnet Control</h1>
      </div>
      <nav aria-label="Primary navigation">
        <%= link_to "Localnet", root_path, class: "nav-link" %>
      </nav>
    </header>

    <main class="page-shell">
      <% flash.each do |type, message| %>
        <div class="flash flash-<%= type %>"><%= message %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
